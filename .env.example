# The settings a staging environment needs. Copy to .env and change the
# passwords. Nothing here is a real secret, and .env must not be committed.

# The database. The password has to be changed before anything is run.
POSTGRES_PASSWORD=change-me

# The mail server the delivery worker sends through. Without a host the
# worker refuses to start, and no confirmation is ever sent.
TELEMEDICINE_SMTP_HOST=
TELEMEDICINE_SMTP_PORT=587
TELEMEDICINE_SMTP_FROM=
TELEMEDICINE_SMTP_USERNAME=
TELEMEDICINE_SMTP_PASSWORD=
TELEMEDICINE_SMTP_TLS=true

# How long the delivery worker waits between passes.
TELEMEDICINE_DELIVERY_INTERVAL=30

# Where the external services are described: which country each is in, and
# the basis and the justification recorded for sending data to it.
TELEMEDICINE_TRANSFER_SERVICES=config/external_services.yaml

# If the mail server is outside Nigeria, these are the basis for sending
# health data to it and the reason. Without both, the transfer is refused.
TELEMEDICINE_SMTP_LAWFUL_BASIS=
TELEMEDICINE_SMTP_JUSTIFICATION=

# The media server, which the practice runs itself in Nigeria. The key and
# the secret are the same ones the server in webrtc-server/ is configured
# with: the application signs the access tokens with them.
TELEMEDICINE_LIVEKIT_HOST=video.example.ng
TELEMEDICINE_LIVEKIT_URL=wss://video.example.ng
TELEMEDICINE_LIVEKIT_API_KEY=
TELEMEDICINE_LIVEKIT_API_SECRET=

# Recording is off, and the patient's consent is needed as well.
TELEMEDICINE_RECORDING_ENABLED=false
TELEMEDICINE_RECORDING_CONSENT_REQUIRED=true
TELEMEDICINE_RECORDING_BUCKET=telemedicine-recordings

# SMART on FHIR. Leave it off: it is only needed to connect to a hospital's
# electronic health record, and the ordinary sign-in is enough without one.
TELEMEDICINE_SMART_FHIR_ENABLED=false
TELEMEDICINE_SMART_CLIENTS=config/smart_clients.yaml
TELEMEDICINE_SMART_STATE_SECRET=
