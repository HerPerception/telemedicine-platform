# The settings a staging environment needs. Copy to .env and change the
# passwords. Nothing here is a real secret, and .env must not be committed.

# The database. The password has to be changed before anything is run.
POSTGRES_PASSWORD=change-me

# The mail server the delivery worker sends through. Without a host the
# worker refuses to start, and no confirmation is ever sent.
TELEMEDICINE_SMTP_HOST=
TELEMEDICINE_SMTP_PORT=587
TELEMEDICINE_SMTP_FROM=
TELEMEDICINE_SMTP_USERNAME=
TELEMEDICINE_SMTP_PASSWORD=
TELEMEDICINE_SMTP_TLS=true

# How long the delivery worker waits between passes.
TELEMEDICINE_DELIVERY_INTERVAL=30
