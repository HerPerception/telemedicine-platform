# The media server's settings. Copy to .env and fill in.
#
# The API key and the secret are the two halves of the credential the
# application signs access tokens with. **The secret is the whole of the
# gate**: anybody who has it can mint a token for any room, so it lives in
# the application's environment and nowhere else, and it is not in this
# file's history.
#
# Generate them with:
#
#     openssl rand -base64 32
#
# and use a different value for each.

# The key the application signs with, and the secret it signs with.
LIVEKIT_API_KEY=REPLACE_WITH_THE_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=REPLACE_WITH_THE_LIVEKIT_API_SECRET

# The public address of this server. The media server needs to know it, or
# the two peers will try to reach each other through an address that is not
# theirs. On a machine behind a port forwarding, this is the public address
# the port is forwarded to.
LIVEKIT_NODE_IP=

# The credential the TURN server gives the relayed connections.
TURN_SECRET=REPLACE_WITH_TURN_SECRET

# The bucket the recordings go into. It is the MinIO container in the same
# compose file, on this machine, in this country.
MINIO_ROOT_USER=telemedicine
MINIO_ROOT_PASSWORD=REPLACE_WITH_A_LONG_PASSWORD
